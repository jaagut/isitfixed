# Example Caddy (v2.7+) reverse proxy for a public CVE Desk instance.
# Caddy obtains and renews the TLS certificate automatically. Replace cve.example.com with your domain.
# The admin dashboard (port 8081) is deliberately NOT proxied: reach it over a VPN or SSH tunnel only.
# Compression is left to the app, which gzips JSON and static files but never the NDJSON progress stream.
cve.example.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	# Requests carry at most a watch list (a few KB); refuse anything large.
	request_body {
		max_size 256KB
	}

	# Progressive case loading streams newline-delimited JSON: flush every line immediately.
	@stream path_regexp stream ^/api/cves/[^/]+/stream$
	reverse_proxy @stream 127.0.0.1:8080 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:8080 {
		# Caddy sets X-Forwarded-For/-Proto; the app trusts them only from FORWARDED_ALLOW_IPS.
		transport http {
			dial_timeout 5s
			response_header_timeout 200s
		}
	}

	# Access log with truncated client addresses (IPv4 /24, IPv6 /48), kept for 14 days at most.
	# To disable access logging entirely, remove this block (Caddy then logs no requests).
	log {
		output file /var/log/caddy/cve-desk-access.log {
			roll_size 20MiB
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>X-Forwarded-For delete
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}
}
