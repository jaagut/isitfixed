# HTTP error entries contain requests (including workspace bearer IDs). Drop the request object.
{
 log default {
  level ERROR
  format filter {
   wrap json
   request delete
  }
 }
}

# Example Caddy (v2.10+) reverse proxy for a public Is It Fixed instance.
# Caddy obtains and renews the TLS certificate automatically. Replace isitfixed.app with your domain.
# The admin dashboard (off by default; ADMIN_PORT) is deliberately NOT proxied: reach it over a VPN or SSH tunnel only.
# Compression is left to the app, which gzips JSON and static files but never the NDJSON progress stream.
isitfixed.app {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	# Requests carry at most a watch list (a few KB); refuse anything large.
	request_body {
		max_size 256KB
	}

	# Progressive case loading streams newline-delimited JSON: flush every line immediately.
	@stream path_regexp stream ^/api/cves/[^/]+/stream$
	reverse_proxy @stream 127.0.0.1:8080 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:8080 {
		# Caddy sets X-Forwarded-For/-Proto; the app trusts them only from FORWARDED_ALLOW_IPS.
		transport http {
			dial_timeout 5s
			response_header_timeout 200s
		}
	}

	# Access logging is off. To enable it, uncomment this block and set LEGAL_ACCESS_LOGS=true in the
	# app, so the privacy policy describes it. It keeps only time, masked client address (/24, /48),
	# method, path and query without workspace IDs, status, size and duration. Files roll daily and
	# are deleted after 13 more days, so no entry is older than 14 days.
	# log {
	# 	output file /var/log/caddy/isitfixed-access.log {
	# 		mode 0640
	# 		roll_interval 24h
	# 		roll_keep_for 312h
	# 		roll_uncompressed
	# 	}
	# 	format filter {
	# 		wrap json
	# 		request>remote_ip ip_mask 24 48
	# 		request>client_ip ip_mask 24 48
	# 		request>uri regexp ^/api/workspaces/[^/?]+ /api/workspaces/-
	# 		request>remote_port delete
	# 		request>proto delete
	# 		request>host delete
	# 		request>headers delete
	# 		request>tls delete
	# 		resp_headers delete
	# 		user_id delete
	# 		bytes_read delete
	# 	}
	# }
}
